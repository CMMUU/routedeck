{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serylane-website",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "routes": [{ "pattern": "serylane.cmmuu.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
